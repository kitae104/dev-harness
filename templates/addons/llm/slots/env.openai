
# AI (LLM). 제공자는 AI_PROVIDER 하나로 바꿉니다: openai | anthropic | ollama. 바꾼 뒤 make up (Windows: docker compose up -d --build).
AI_PROVIDER=openai
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=240

# OpenAI. 키가 비어 있으면 AI 요청만 502 로 실패합니다.
# OpenAI 호환 서버(Groq, Together, vLLM, LM Studio 등)를 쓰려면 OPENAI_BASE_URL 과 모델 이름을 바꾸세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (무료, 내 PC 에서 실행). 쓰는 법:
#   1) AI_PROVIDER=ollama
#   2) Ollama 를 어디서 띄울지 고르기 (COMPOSE_PROFILES)
#        ollama      이 프로젝트 컨테이너, CPU (Windows·macOS·Linux 모두)
#        ollama-gpu  이 프로젝트 컨테이너, NVIDIA GPU (Windows 는 Docker Desktop + WSL2, Linux 는 NVIDIA Container Toolkit)
#        (비움)      PC 에 직접 설치한 Ollama 사용. macOS 에서 Apple GPU 를 쓰려면 이쪽 (Docker 는 Apple GPU 를 못 씀)
#                    이때 OLLAMA_DOCKER_URL=http://host.docker.internal:11434
#   3) make up → make ai-model (처음 한 번 모델 내려받기)
COMPOSE_PROFILES=
OLLAMA_MODEL=gemma3:4b
OLLAMA_PORT=11434
# 한 번에 읽는 길이(토큰). 긴 프롬프트가 잘리면 늘리고, 메모리가 부족하면 줄입니다.
OLLAMA_CONTEXT_LENGTH=8192
# 마지막 요청 뒤 모델을 메모리에 남겨 둘 시간 (첫 응답이 느린 것을 줄임)
OLLAMA_KEEP_ALIVE=30m
# 백엔드를 로컬(make backend-dev)에서 띄울 때 쓰는 주소. 컨테이너 안의 백엔드는 OLLAMA_DOCKER_URL 을 씁니다.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434
